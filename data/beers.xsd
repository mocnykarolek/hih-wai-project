<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- Definicja głównego elementu beers -->
  <xs:element name="beers">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="beer" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <!-- ID piwa - musi być liczbą całkowitą większą od 0 -->
              <xs:element name="id">
                <xs:simpleType>
                  <xs:restriction base="xs:integer">
                    <xs:minInclusive value="1"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              
              <!-- Nazwa piwa - tekst od 2 do 50 znaków -->
              <xs:element name="name">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:minLength value="2"/>
                    <xs:maxLength value="50"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              
              <!-- Typ piwa - tylko określone wartości -->
              <xs:element name="type">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="Lager"/>
                    <xs:enumeration value="Porter"/>
                    <xs:enumeration value="Wheat Beer"/>
                    <xs:enumeration value="IPA"/>
                    <xs:enumeration value="Stout"/>
                    <xs:enumeration value="Ale"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              
              <!-- Browar - tekst od 3 do 100 znaków -->
              <xs:element name="brewery">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:minLength value="3"/>
                    <xs:maxLength value="100"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              
              <!-- Zawartość alkoholu - liczba od 0 do 20 z jednym miejscem po przecinku -->
              <xs:element name="alcohol">
                <xs:simpleType>
                  <xs:restriction base="xs:decimal">
                    <xs:minInclusive value="0.0"/>
                    <xs:maxInclusive value="20.0"/>
                    <xs:fractionDigits value="1"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              
              <!-- Opis - tekst do 500 znaków -->
              <xs:element name="description">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:maxLength value="500"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              
              <!-- Lista składników -->
              <xs:element name="ingredients">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="ingredient" type="xs:string" minOccurs="1" maxOccurs="10"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              
              <!-- Cena - liczba dodatnia z dwoma miejscami po przecinku -->
              <xs:element name="price">
                <xs:simpleType>
                  <xs:restriction base="xs:decimal">
                    <xs:minInclusive value="0.01"/>
                    <xs:fractionDigits value="2"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  
</xs:schema>